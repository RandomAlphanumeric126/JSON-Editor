import { getDataType } from './helpers.js';
import { getBranchingSubkeys } from './jsonHandler.js';

/** Get the <li> DOM node within the path tree associated with the given path.
 * 
 * @param {Array} _pathArr An array of strings representing the path to a nested value inside a JSON object.
 * @param {HTMLLIElement} _treeRoot The root node of the path tree.
 * @returns {HTMLLIElement} The <li> DOM node within the path tree associated with the given path.
 */
// FIXME: Unfinished. Need to handle when dom node doesn't yet exist.
// TODO: Need to create globals proxy object to include _treeRoot
export function getTreeNode(_pathArr, _treeRoot) {

   const typeof_pathArr = getDataType(_pathArr);

   if ( typeof_pathArr !== 'array' ) { console.error(`Expected array but recieved ${typeof_pathArr}`); }

   // Start at the given node, or the root node
   let currentTreeNode = _treeRoot;

   
   // Traverse the DOM along the given path
   for (const value of _pathArr) {
      currentTreeNode = currentTreeNode.querySelector(`[data-key="${value}"]`);
   }

   return currentTreeNode;

}


/** Returns the array of data-keys used to generate the given _domNode from associated JSON data  */
export function getPathFromTree(_domNode) {

   let currentDomNode = _domNode;
   let parentNode     = currentDomNode.parentNode.parentNode;

   const inversePath = [];

   while ( currentDomNode.dataset.key !== 'root' ) {
      if (currentDomNode.dataset.key) { inversePath.push(currentDomNode.dataset.key); }
      currentDomNode = parentNode;
      parentNode = parentNode.parentNode;
   }

   return inversePath.reverse();

}


/** Builds an unordered list based on the given array of keys.
 * @param {Array} _childrenArr - A 2d array where each entry is an array with a key name and a boolean indicating if it has sub-keys.
 * @returns {HTMLUListElement} - An unorded list with <li>s for each key in the given array.
 */
export function generateNestedList(_childrenArr) {

   // Don't waste resources if there are no child branches to build.
   if (_childrenArr.length === 0) return;

   const ul = document.createElement('ul');

   for ( const [i_key, i_hasSubKeys] of _childrenArr ) { // Example of 'array destructuring'

      // Build the elements for the current child in the array
      const li         = document.createElement('li');      // wraps the key and button/spacer
      const keyWrapper = document.createElement('span');    // wrap the key for styling
      let   expander   = document.createElement('span');    // initialize as a blank spacer

      // Add a button for expanding/collapsing branches
      if (i_hasSubKeys) {

         expander = document.createElement('button');  // convert the span to a button

         expander.classList.add('expander');
         expander.textContent = '+';
         
      }

      // Prep the key wrapper
      keyWrapper.classList.add('key');
      keyWrapper.textContent = i_key;

      // Assemble the li
      li.dataset.key = i_key;
      li.appendChild(expander);
      li.appendChild(keyWrapper);
      li.classList.add(
         (expander.nodeName === "BUTTON") ? 'branch' : 'leaf'  // NOTE: Is this really necessary?
      );


      // Append the li to the ul
      ul.appendChild(li);

   }


   return ul;

}


// TODO: Further generalize to accept any json data instead of only the root of specific data
export function generateBranch(_pathArr, _jsonObject, _domNode = null) {

   // Locate the root node in the dom (if none is provided)
   let initialNode = _domNode;

   // Handle Case: Empty pathArr is the path to the root node
   if (_pathArr.length === 0) {

      addPathBranch(_jsonObject, initialNode);
      return;

   }

   // Handle Case: Not an empty pathArr
   else {

      // Prep the relevant nodes
      let jsonObject  = _jsonObject;
      let parentNode  = null;
      let currentNode = initialNode;
      let nextNode    = null;

      for ( let i = 0; i < _pathArr.length; ++i ) {
      
         // Step into the JSON node
         jsonObject  = jsonObject[_pathArr[i]];

         // Prep the DOM nodes
         parentNode  = currentNode;
         currentNode = currentNode.querySelector(`[data-key="${_pathArr[i]}"]`);
         nextNode    = currentNode.querySelector(`[data-key="${_pathArr[i + 1]}"]`);
         
         
         // Current DOM node's children have already been generated with their data-key's
         if (nextNode) {

            expandBranch(currentNode.querySelector('.expander'));
            continue;

         }

         // Current DOM node's children have not been generated yet
         else if ( ! currentNode.querySelector('[data-key]') ) {

            addPathBranch(jsonObject, currentNode);

         }

      }

   }
}


// FIXME: Doesn't work if the root node has not been generated yet
// TODO: Verify the requested node doesn't yet exist in the dom
export function addPathBranch(_jsonObject, _domNode) {

   // Build the next branch
   const childBranches = getBranchingSubkeys(_jsonObject);
   const newBranch     = generateNestedList(childBranches);
   
   // Append the new branch to the current node
   _domNode.appendChild(newBranch);

   // Expand the new branch by default
   expandBranch(_domNode.querySelector('.expander'));

}


// Takes a expanderBtn with a class of collapsed
export function expandBranch(_expanderBtn) {

   if ( _expanderBtn.classList.contains('expanded') ) return;

   _expanderBtn.classList.remove('collapsed');
   _expanderBtn.classList.add('expanded');

   _expanderBtn.textContent = '-';
}


// Takes a expanderBtn with a class of expanded
export function collapseBranch(_expanderBtn) {

   if ( _expanderBtn.classList.contains('collapsed') ) return;

   _expanderBtn.classList.remove('expanded');
   _expanderBtn.classList.add('collapsed');

   _expanderBtn.textContent = '+';
}